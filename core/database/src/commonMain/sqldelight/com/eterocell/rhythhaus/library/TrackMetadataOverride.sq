CREATE TABLE track_metadata_override (
    trackId TEXT NOT NULL PRIMARY KEY REFERENCES library_track(id) ON DELETE CASCADE,
    title TEXT,
    artist TEXT,
    album TEXT,
    trackNumber INTEGER CHECK (trackNumber IS NULL OR trackNumber > 0),
    discNumber INTEGER CHECK (discNumber IS NULL OR discNumber > 0)
);

selectAllOverrides:
SELECT trackId, title, artist, album, trackNumber, discNumber
FROM track_metadata_override;

selectOverrideForTrack:
SELECT trackId, title, artist, album, trackNumber, discNumber
FROM track_metadata_override WHERE trackId = ?;

selectTrackExists:
SELECT EXISTS(SELECT 1 FROM library_track WHERE id = :trackId);

upsertOverride:
INSERT INTO track_metadata_override(trackId, title, artist, album, trackNumber, discNumber)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(trackId) DO UPDATE SET
    title = excluded.title,
    artist = excluded.artist,
    album = excluded.album,
    trackNumber = excluded.trackNumber,
    discNumber = excluded.discNumber;

deleteOverride:
DELETE FROM track_metadata_override WHERE trackId = ?;
