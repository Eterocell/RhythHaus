{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "document": "RhythHaus platform-adaptive redesign color tokens",
  "status": "Design values proposed for joint design and implementation-plan approval",
  "version": 1,
  "appearanceModes": ["system", "light", "dark"],
  "defaultPalette": "moss",
  "defaultDynamicColor": false,
  "dynamicColor": {
    "platform": "Android",
    "minimumApi": 31,
    "source": "platform dynamic color scheme",
    "fallback": "last-selected-curated-palette",
    "statusCopy": "当前使用精选色板"
  },
  "contrastRequirements": {
    "primaryTextAndSecondaryTextOnTheirSurface": 4.5,
    "actionContentOnAction": 4.5,
    "selectedContentOnSelectedSurface": 4.5,
    "semanticStatusContentOnContainer": 4.5,
    "focusAndEssentialBoundaryAgainstAdjacentSurface": 3.0,
    "alphaComposites": "Evaluate against the final rendered background"
  },
  "canonicalResolution": {
    "authority": "One resolved Haus scheme containing paletteId, requested appearance mode, resolved isDark, effective source, and the complete semantic roles below",
    "modeResolution": "Resolve system/light/dark once. Reuse resolved isDark for the selected curated palette or Android dynamic light/dark scheme; never infer darkness by comparing palette colors.",
    "dynamicResolution": "Android dynamic colors are an input to this same Haus scheme. Preserve the last curated palette as fallback. Warning and success semantics remain curated and do not change with wallpaper colors."
  },
  "androidDynamicSchemeToHaus": {
    "background": "background",
    "surface": "surface",
    "surfaceContainerHigh": "raisedSurface",
    "surfaceContainerLow": "navigationSurface",
    "onSurface": "textPrimary",
    "onSurfaceVariant": "textSecondary",
    "inverseOnSurface": "textInverse",
    "primary": "primaryAction",
    "onPrimary": "onPrimaryAction",
    "primaryContainer": "selectedSurface",
    "onPrimaryContainer": "onSelectedSurface",
    "outlineVariant": "divider",
    "outline": "essentialBoundary",
    "primary (focus indicator)": "focus",
    "error": "error",
    "onError": "onError",
    "errorContainer": "errorContainer",
    "onErrorContainer": "onErrorContainer",
    "warning and success roles": "Use the fixed semantic status roles from the selected curated palette; do not derive these from wallpaper hues."
  },
  "miuixColorSchemeMapping": {
    "primary": "primaryAction",
    "onPrimary": "onPrimaryAction",
    "secondary": "primaryAction",
    "onSecondary": "onPrimaryAction",
    "background": "background",
    "onBackground": "textPrimary",
    "surface": "surface",
    "onSurface": "textPrimary",
    "surfaceContainer": "raisedSurface",
    "onSurfaceContainer": "textPrimary",
    "secondaryVariant": "primaryAction",
    "onSecondaryVariant": "onPrimaryAction",
    "disabledSecondaryVariant": "disabledSurface",
    "disabledOnSecondaryVariant": "disabledContent"
  },
  "material3ColorSchemeMapping": {
    "primary/onPrimary": "primaryAction/onPrimaryAction",
    "primaryContainer/onPrimaryContainer": "selectedSurface/onSelectedSurface",
    "secondary/onSecondary": "primaryAction/onPrimaryAction",
    "secondaryContainer/onSecondaryContainer": "raisedSurface/textPrimary",
    "tertiary/onTertiary": "primaryAction/onPrimaryAction",
    "tertiaryContainer/onTertiaryContainer": "selectedSurface/onSelectedSurface",
    "background/onBackground": "background/textPrimary",
    "surface/onSurface": "surface/textPrimary",
    "surfaceVariant/onSurfaceVariant": "raisedSurface/textSecondary",
    "surfaceTint": "primaryAction",
    "surfaceDim/surfaceBright": "background/surface",
    "surfaceContainerLowest/surfaceContainerLow": "background/surface",
    "surfaceContainer/surfaceContainerHigh/surfaceContainerHighest": "raisedSurface",
    "outline/outlineVariant": "essentialBoundary/divider",
    "scrim": "scrimColor (consumers apply scrimAlpha)",
    "error/onError": "error/onError",
    "errorContainer/onErrorContainer": "errorContainer/onErrorContainer",
    "inverseSurface/inverseOnSurface": "textPrimary/textInverse",
    "inversePrimary": "primaryAction"
  },
  "contrastEvidence": {
    "method": "Computed from the opaque sRGB hex role values using WCAG relative luminance. Alpha overlays and Android dynamic colors require separate composited/device validation.",
    "metrics": [
      "minimum textPrimary/textSecondary across background, surface, raisedSurface, navigationSurface",
      "textInverse on textPrimary (inverse surface)",
      "onPrimaryAction on primaryAction",
      "onSelectedSurface on selectedSurface",
      "minimum status content on each semantic container",
      "minimum error/warning/success text on background or surface",
      "disabledContent on disabledSurface (informative)",
      "focus against base surfaces",
      "essentialBoundary against base surfaces"
    ],
    "minimumRatios": {
      "moss": {
        "light": [6.26, 14.74, 7.59, 11.05, 9.56, 6.12, 5.23, 6.52, 3.50],
        "dark": [7.51, 12.98, 9.61, 9.57, 8.39, 9.26, 5.83, 8.24, 3.49]
      },
      "bay": {
        "light": [6.49, 14.95, 7.04, 11.38, 9.56, 6.13, 5.11, 6.08, 3.48],
        "dark": [7.16, 12.82, 9.08, 9.17, 8.39, 9.16, 5.92, 7.95, 3.54]
      },
      "clay": {
        "light": [6.77, 15.10, 6.47, 11.59, 9.56, 6.15, 5.43, 5.39, 3.47],
        "dark": [6.87, 12.86, 10.85, 10.42, 8.39, 9.28, 6.15, 9.40, 3.72]
      },
      "iris": {
        "light": [6.99, 14.83, 6.80, 11.57, 9.56, 6.11, 5.43, 5.70, 3.59],
        "dark": [7.29, 12.82, 9.06, 10.11, 8.39, 9.26, 6.14, 8.20, 3.57]
      }
    }
  },
  "roles": [
    "background", "surface", "raisedSurface", "navigationSurface",
    "textPrimary", "textSecondary", "textInverse",
    "primaryAction", "onPrimaryAction", "selectedSurface", "onSelectedSurface",
    "divider", "essentialBoundary", "focus",
    "disabledSurface", "disabledContent",
    "error", "onError", "errorContainer", "onErrorContainer",
    "warning", "onWarning", "warningContainer", "onWarningContainer",
    "success", "onSuccess", "successContainer", "onSuccessContainer",
    "scrimColor", "scrimAlpha"
  ],
